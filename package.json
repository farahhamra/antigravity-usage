{
  "name": "antigravity-usage",
  "displayName": "Antigravity Usage",
  "description": "Live request activity, reported input/output tokens, and a local usage dashboard for Google Antigravity.",
  "version": "0.3.1",
  "publisher": "farahhamra",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/farahhamra/antigravity-usage.git"
  },
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=22"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "antigravityUsage.openDashboard",
        "title": "Antigravity Usage: Open Dashboard"
      },
      {
        "command": "antigravityUsage.selectModel",
        "title": "Antigravity Usage: Select Model for Manual Timer"
      },
      {
        "command": "antigravityUsage.startTimer",
        "title": "Antigravity Usage: Start Manual Request Timer"
      },
      {
        "command": "antigravityUsage.finishTimer",
        "title": "Antigravity Usage: Finish Manual Request Timer"
      },
      {
        "command": "antigravityUsage.cancelTimer",
        "title": "Antigravity Usage: Cancel Manual Request Timer"
      },
      {
        "command": "antigravityUsage.exportData",
        "title": "Antigravity Usage: Export Usage JSON"
      },
      {
        "command": "antigravityUsage.clearData",
        "title": "Antigravity Usage: Clear Usage History"
      },
      {
        "command": "antigravityUsage.inspectIntegration",
        "title": "Antigravity Usage: Inspect Antigravity Integration"
      },
      {
        "command": "antigravityUsage.setSubscriptionDate",
        "title": "Antigravity Usage: Set Subscription Start Date"
      }
    ],
    "configuration": {
      "title": "Antigravity Usage",
      "properties": {
        "antigravityUsage.subscriptionStartDate": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Subscription start date (YYYY-MM-DD) for the activity calendar. Leave blank to hide the marker."
        },
        "antigravityUsage.subscriptionMarker": {
          "type": "string",
          "enum": [
            "monthly",
            "startDate"
          ],
          "enumDescriptions": [
            "Repeat on the subscription day each month; use the last day of shorter months.",
            "Mark only the original subscription start date."
          ],
          "default": "monthly",
          "scope": "application",
          "description": "How the subscription date appears on the monthly activity calendar."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test/test/*.test.js",
    "vscode:prepublish": "npm run compile",
    "package": "node -e \"require('node:fs').mkdirSync('artifacts', { recursive: true })\" && vsce package --no-dependencies --skip-license --out artifacts/antigravity-usage.vsix"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "@types/node": "22.20.5",
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "4.0.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3"
  }
}
